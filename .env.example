APP_NAME=Agentic Registrar System
DEBUG=true
ENVIRONMENT=development

# Public URL for links in emails (no trailing slash), e.g. https://api.yourdomain.edu
PUBLIC_APP_BASE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/registrar_db

# Authentication
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Tuition / cost-sharing pricing
# Per-credit-hour rate billed to self-sponsored students each term.
# Government-sponsored students see the same line items on their
# invoice but pay 0 — cost-sharing covers the bill.
FEE_PER_CREDIT_HOUR_BIRR=100
TUITION_CURRENCY=ETB

# Logging
LOG_LEVEL=DEBUG

# AI / Gemini (advisory narrative LLM)
# Leave GEMINI_API_KEY empty to disable the LLM and fall back to the
# rule-based advisory explanation. gemini-2.5-flash-lite is on Google's
# free tier (15 RPM / 1500 RPD).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
ADVISORY_LLM_MODEL=gemini-2.5-flash-lite
ADVISORY_LLM_TIMEOUT_SECONDS=5.0
ADVISORY_LLM_MAX_TOKENS=600

EMAIL_ENABLED=true
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Agentic Registrar
EMAIL_TIMEOUT_SECONDS=15
