APP_NAME=Agentic Registrar System
DEBUG=true
ENVIRONMENT=development

# Public URL for links in emails (no trailing slash), e.g. https://api.yourdomain.edu
PUBLIC_APP_BASE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/registrar_db

# Authentication
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Logging
LOG_LEVEL=DEBUG

# AI / Anthropic (advisory narrative LLM)
# Leave ANTHROPIC_API_KEY empty to disable the LLM and fall back to the
# rule-based advisory explanation. Model defaults to Claude Haiku 4.5
# for cost+latency on short narratives.
ANTHROPIC_API_KEY=
ADVISORY_LLM_MODEL=claude-haiku-4-5
ADVISORY_LLM_TIMEOUT_SECONDS=5.0
ADVISORY_LLM_MAX_TOKENS=600

EMAIL_ENABLED=true
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Agentic Registrar
EMAIL_TIMEOUT_SECONDS=15
